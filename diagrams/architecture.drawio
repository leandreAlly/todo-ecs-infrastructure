        <mxCell id="c1" value='&lt;span style="font-size:22px;font-weight:bold;color:#232F3E;"&gt;To-Do on Amazon ECS Fargate&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#545B64;"&gt;RDS Proxy for writes, ElastiCache for reads, CodeDeploy blue/green delivery. Provisioned by CloudFormation Git sync; GitHub Actions uses OIDC, no long-lived AWS keys.&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="56" as="geometry"/></mxCell>
